---
// A hidden solution: closed on every visit, opened by click or keyboard, and it remembers nothing.
interface Props {
	label?: string;
}

const { label = 'Show code' } = Astro.props;
---

<details class="solution">
	<summary>{label}</summary>
	<div class="solution-body">
		<slot />
	</div>
</details>

<script>
	// Code blocks are measured while the solution is closed, so none look scrollable then. Once it opens, any block wider
	// than its frame gets a tab stop, so keyboard users can scroll it.
	for (const solution of document.querySelectorAll<HTMLDetailsElement>('details.solution')) {
		solution.addEventListener('toggle', () => {
			if (!solution.open) return;
			for (const block of solution.querySelectorAll<HTMLElement>('pre')) {
				if (block.scrollWidth > block.clientWidth) block.tabIndex = 0;
			}
		});
	}
</script>

<style>
	.solution {
		margin-top: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6);
	}

	summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.875rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--sl-color-text-accent);
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(-45deg);
		transition: transform 0.15s ease;
	}

	.solution[open] summary::before {
		transform: rotate(45deg);
	}

	summary:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
		border-radius: 0.5rem;
	}

	.solution-body {
		padding: 0 0.875rem 0.875rem;
	}

	@media (prefers-reduced-motion: reduce) {
		summary::before {
			transition: none;
		}
	}
</style>
