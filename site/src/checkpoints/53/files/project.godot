[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
anti_aliasing/quality/msaa_3d=2

[shader_globals]

rim_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
rim_strength={
"type": "float",
"value": 0.0
}
wind_direction={
"type": "vec2",
"value": Vector2(1, 0.4)
}
wind_strength={
"type": "float",
"value": 0.6
}
push_point={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_texture={
"type": "sampler2D",
"value": "res://art/clouds/cloud_noise.tres"
}
cloud_scale={
"type": "float",
"value": 45.0
}
cloud_strength={
"type": "float",
"value": 0.5
}
